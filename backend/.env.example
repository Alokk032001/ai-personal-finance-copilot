# Copy to backend/.env (git-ignored). application.yml only uses ${VAR} placeholders.

# Supabase Session pooler (port 5432). sslmode=require.
# Split user/password out of the URL — do not embed credentials in POSTGRES_URL.
# Direct IPv6 host fails on many home networks.
POSTGRES_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_USER=postgres.your_project_ref
POSTGRES_PASSWORD=your_db_password

MONGODB_URI=mongodb+srv://user:xxxxxx@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=finance_copilot

# HS256 secret, at least 32 bytes
JWT_SECRET=3XYgPE9vVxBQN7z5TsHwZAr8HwYmsE4iHSSmf5vFPww=

# stub | gemini | claude
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL=
